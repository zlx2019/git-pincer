# Consistent code style across editors: https://editorconfig.org
root = true

# Defaults: UTF-8, LF line endings, final newline, trimmed trailing whitespace, 4-space indent
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# 2-space indent for config files
[*.{toml,yml,yaml,json}]
indent_size = 2

# Trailing whitespace is meaningful in Markdown (hard line break), so keep it
[*.md]
trim_trailing_whitespace = false
